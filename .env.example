# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://afterchime_runtime:***@127.0.0.1:54329/afterchime
DATABASE_MIGRATOR_URL=postgresql://afterchime_migrator:***@127.0.0.1:54329/afterchime
AFTERCHIME_DEV_POSTGRES_PASSWORD=replace-me
AFTERCHIME_DEV_MIGRATOR_PASSWORD=replace-me
AFTERCHIME_DEV_RUNTIME_PASSWORD=replace-me
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
ADMIN_API_KEY_HASH=
CORS_ORIGINS=

# Development-only feature gates
ALLOW_DEV_AUTH=true
BILLING_PROVIDER=fake
ANALYTICS_RAW_RETENTION_DAYS=730
