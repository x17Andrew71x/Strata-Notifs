# Afterchime production server — values are examples, never credentials.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Use separate production-only roles and credentials.
DATABASE_URL=postgresql://afterchime_runtime:***@postgres.railway.internal:5432/afterchime
DATABASE_MIGRATOR_URL=postgresql://afterchime_migrator:***@postgres.railway.internal:5432/afterchime
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
ADMIN_API_KEY_HASH=

# Development-only infrastructure is forbidden in production.
DEV_FEEDBACK_ENABLED=false
DEV_FEEDBACK_DECREE_ADMIN_KEY_HASH=
DEV_FEEDBACK_DECREE_CLIENT_KEY_HASH=
DEV_FEEDBACK_DECREE_DEPLOYMENT_URL=
DEV_FEEDBACK_PJS_ADMIN_KEY_HASH=
DEV_FEEDBACK_PJS_CLIENT_KEY_HASH=
DEV_FEEDBACK_PJS_DEPLOYMENT_URL=
ALLOW_DEV_AUTH=false

# Fake billing is rejected in production. Commerce routes remain unpublished until implemented.
BILLING_PROVIDER=google-play
CORS_ORIGINS=https://replace-with-production-host.example
ANALYTICS_RAW_RETENTION_DAYS=730
