{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratawake.invalid/contracts/events/v1/notification-access-result.schema.json",
  "title": "Stratawake Analytics Event v1: notification_access_result",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "type": "object",
      "required": ["event_name", "properties"],
      "properties": {
        "event_name": {
          "const": "notification_access_result"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result"],
          "properties": {
            "result": {
              "enum": ["granted", "denied", "unavailable"]
            }
          }
        }
      }
    }
  ]
}
