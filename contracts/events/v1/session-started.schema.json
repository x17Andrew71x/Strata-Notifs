{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afterchime.invalid/contracts/events/v1/session-started.schema.json",
  "title": "Afterchime Analytics Event v1: session_started",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "type": "object",
      "required": ["event_name", "properties"],
      "properties": {
        "event_name": {
          "const": "session_started"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry_point"],
          "properties": {
            "entry_point": {
              "enum": ["cold_start", "foreground_return"]
            }
          }
        }
      }
    }
  ]
}
